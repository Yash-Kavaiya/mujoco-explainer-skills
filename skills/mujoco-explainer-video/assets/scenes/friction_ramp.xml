<!-- Coulomb friction on a 25 degree ramp (tan 25 = 0.47). The ramp's friction is tiny and MuJoCo uses the max of the pair, so each box decides: box_ice (0.1) and box_wood (0.35) slide, box_rubber (0.8) sticks. -->
<mujoco model="friction_ramp">
  <option timestep="0.001" cone="elliptic" impratio="10"/>
  <visual>
    <headlight ambient="0.25 0.25 0.28" diffuse="0.55 0.55 0.55" specular="0.1 0.1 0.1"/>
    <rgba haze="0.05 0.06 0.08 1"/>
    <global azimuth="90" elevation="-15" offwidth="1920" offheight="1080" fovy="40"/>
    <quality shadowsize="4096" offsamples="8"/>
    <map znear="0.01" zfar="50"/>
  </visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.13 0.15 0.20" rgb2="0.02 0.02 0.03" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" mark="edge" rgb1="0.15 0.17 0.21" rgb2="0.11 0.12 0.15" markrgb="0.32 0.36 0.44" width="300" height="300"/>
    <material name="floor" texture="grid" texuniform="true" texrepeat="4 4" reflectance="0.12"/>
    <material name="cyan" rgba="0.30 0.79 0.94 1" specular="0.6" shininess="0.7"/>
    <material name="pink" rgba="0.97 0.15 0.52 1" specular="0.6" shininess="0.7"/>
    <material name="gold" rgba="1.00 0.82 0.40 1" specular="0.6" shininess="0.7"/>
    <material name="mint" rgba="0.02 0.84 0.63 1" specular="0.6" shininess="0.7"/>
    <material name="violet" rgba="0.70 0.53 1.00 1" specular="0.6" shininess="0.7"/>
    <material name="steel" rgba="0.55 0.58 0.64 1" specular="0.8" shininess="0.9" reflectance="0.2"/>
    <material name="dark" rgba="0.20 0.22 0.27 1" specular="0.3" shininess="0.3"/>
  </asset>
  <worldbody>
    <light name="key" pos="1.5 -2.5 4" dir="-0.3 0.6 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="true"/>
    <light name="fill" pos="-2 2 3" dir="0.5 -0.5 -1" diffuse="0.25 0.25 0.3" castshadow="false"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>
    <camera name="front" pos="0.2 -6.5 1.3" xyaxes="1 0 0 0 0.1 1"/>
    <frame pos="0 0 1" euler="0 25 0">
      <geom name="ramp" type="box" size="2 0.75 0.05" material="dark" friction="0.01 0.005 0.0001"/>
      <body name="box_ice" pos="-1.3 -0.45 0.16"><freejoint/><geom type="box" size="0.1 0.1 0.1" material="cyan" friction="0.1 0.005 0.0001" mass="1"/></body>
      <body name="box_wood" pos="-1.3 0 0.16"><freejoint/><geom type="box" size="0.1 0.1 0.1" material="gold" friction="0.35 0.005 0.0001" mass="1"/></body>
      <body name="box_rubber" pos="-1.3 0.45 0.16"><freejoint/><geom type="box" size="0.1 0.1 0.1" material="pink" friction="0.8 0.005 0.0001" mass="1"/></body>
    </frame>
    <geom name="ramp_leg" type="box" pos="-1.81 0 0.9" size="0.05 0.5 0.9" material="dark"/>
  </worldbody>
</mujoco>
